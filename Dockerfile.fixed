# Multi-stage build for CF Travel Bot
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev deps for build)
RUN npm ci && npm cache clean --force

# Copy all configuration files first
COPY vite.config.js ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./
COPY vitest.config.js ./
COPY postcss.config.cjs ./
COPY tailwind.config.js ./
COPY components.json ./
COPY index.html ./

# Copy source directories
COPY src ./src
COPY server ./server
COPY public_html ./public_html

# Build the application with explicit NODE_ENV
ENV NODE_ENV=production
RUN npm run build

# Production stage
FROM node:18-alpine AS production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create app user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S app -u 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --only=production && npm cache clean --force

# Copy built application from builder stage
COPY --from=builder --chown=app:nodejs /app/dist ./dist
COPY --from=builder --chown=app:nodejs /app/server ./server

# Create logs directory
RUN mkdir -p /app/logs && chown app:nodejs /app/logs

# Switch to non-root user
USER app

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "const http = require('http'); const options = { host: 'localhost', port: 3000, path: '/health', timeout: 2000 }; const req = http.request(options, (res) => { if (res.statusCode === 200) { process.exit(0); } else { process.exit(1); } }); req.on('error', () => process.exit(1)); req.end();"

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Start application using dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/main.js"]